# ---------------------------------------------------------------------------
# SetMeister — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection, used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/setmeister?sslmode=require"
# Direct (non-pooled) connection. Used ONLY by `prisma migrate` — poolers
# cannot run migrations. In Neon this is the same host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/setmeister?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Leave AUTH_URL UNSET for local development. With trustHost enabled Auth.js
# infers the origin from the request, so the app works on whatever port Next
# picks. Pinning it to one port makes sign-in redirect to the wrong origin the
# moment port 3000 is taken. Set it only for a fixed production domain.
# AUTH_URL="https://setmeister.example.com"

# --- AI --------------------------------------------------------------------
# "openai" (default) or "anthropic". Both adapters are built; this only picks
# which one the app uses, so the provider can change without a code change.
AI_PROVIDER="openai"
AI_MODEL="gpt-5"
OPENAI_API_KEY=""
# Optional: point at any OpenAI-compatible endpoint (Azure, OpenRouter, local).
OPENAI_BASE_URL=""
# Only needed when AI_PROVIDER="anthropic".
ANTHROPIC_API_KEY=""

# --- Email (Resend) --------------------------------------------------------
# Invitations still record in Messages when unset; they just are not delivered.
RESEND_API_KEY=""
EMAIL_FROM="SetMeister <noreply@example.com>"

# --- File storage (Vercel Blob) --------------------------------------------
# Chord chart PDFs. Serverless has no writable filesystem, so this is required
# for uploads to work in production.
BLOB_READ_WRITE_TOKEN=""

# --- App -------------------------------------------------------------------
# Absolute base used to build invitation links inside emails.
# Song search (MusicBrainz). No API key exists — this contact string IS the
# credential. MusicBrainz requires a User-Agent that identifies the app and
# gives them a way to reach you; anonymous agents get throttled hard.
# Leave blank and search falls back to a small built-in demo catalogue.
MUSICBRAINZ_CONTACT="you@example.com"

APP_URL="http://localhost:3000"
# Separate secret for signing public invitation / availability tokens.
INVITATION_TOKEN_SECRET=""
